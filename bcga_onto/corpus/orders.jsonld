      "bcga:character": "Solid, unornamented, virile",
      "bcga:suitedTo": [
        "gates",
        "baths",
        "workshops",
        "farm buildings",
        "harbour works"
      ],
      "bcga:slendernessRank": 1,
      "dcterms:source": [
        {
          "@id": "bcga:Vitruvius-IV.1"
        },
        {
          "@id": "bcga:Vitruvius-I.2"
        }
      ]
    },
    {
