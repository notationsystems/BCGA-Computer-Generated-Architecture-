  "@graph": [
    {
      "@id": "bcga:Order",
      "@type": "rdfs:Class",
      "rdfs:label": "Order",
      "rdfs:comment": "One of the five orders. Every dimension is stated in M, the diameter of the column at its base, so an order is a set of ratios rather than sizes."
    },
    {
      "@id": "bcga:tuscan",
      "@type": "bcga:Order",
      "rdfs:label": "Tuscan",
      "bcga:columnHeight": 7,
      "bcga:entablatureRatio": 0.25,
      "bcga:architraveShare": 0.3,
      "bcga:friezeShare": 0.3,
      "bcga:corniceShare": 0.4,
      "bcga:flutes": 0,
