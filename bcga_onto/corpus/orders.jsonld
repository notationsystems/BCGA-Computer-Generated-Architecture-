    {
      "@id": "bcga:entablatureDivision",
      "@type": "bcga:Rule",
      "rdfs:label": "Entablature division",
      "rdfs:comment": "The entablature divides into ten parts: architrave 3, frieze 3, cornice 4. Palladio varies this slightly by order; 3:3:4 is the safe default. The cornice projects roughly its own height.",
      "dcterms:source": {
        "@id": "bcga:Vitruvius-IV.1"
      }
    },
    {
      "@id": "bcga:pedimentPitch",
      "@type": "bcga:Rule",
      "rdfs:label": "Pediment",
      "rdfs:comment": "Vitruvius sets the tympanum height at 1/9 of the cornice span for temples, a pitch near 12.5 degrees. Palladio's is steeper, near 22 to 27 degrees. NOTE ON THE SOURCE: the ratio is recorded here against the FULL span. The usual phrasing, '1/4 to 1/5 of the half-span', is inconsistent with the pitch quoted alongside it -- taken against the half-span it yields 12.7 degrees, not the stated ~22 -- whereas against the full span it yields 21.8 to 26.6 degrees, which matches. The checkable quantity, the pitch, is treated as authoritative over the ambiguous wording.",
      "bcga:vitruvianTympanumRatio": 0.1111111111111111,
      "dcterms:source": {
        "@id": "bcga:Vitruvius-III.5"
      },
      "bcga:vitruvianPitchDegrees": 12.528807709151492,
      "bcga:palladianSpanRatioMin": 0.2,
      "bcga:palladianSpanRatioMax": 0.25,
      "bcga:palladianPitchDegreesMin": 21.801409486351815,
      "bcga:palladianPitchDegreesMax": 26.56505117707799
    },
    {
      "@id": "bcga:cornerColumnThickening",
      "@type": "bcga:Rule",
      "rdfs:label": "Corner column thickening",
      "rdfs:comment": "Corner columns are thickened by 1/50 of their diameter, because outdoor light erodes their silhouette. Eurythmia outranks arithmetic: the architect counteracts the deception of the eye by calculation.",
      "bcga:factor": 0.02,
      "dcterms:source": {
        "@id": "bcga:Vitruvius-III.3"
      }
    }
  ]
}
